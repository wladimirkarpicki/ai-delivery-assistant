# Copy to .env and fill in real values. NEVER commit the real .env file.
#
# Every secret below is intentionally left EMPTY. There is deliberately no
# placeholder value for anything that signs tokens or authenticates a user:
# a predictable default is worse than a missing one, because it looks like
# it works. Generate real values with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Runtime mode ---
# production  -> refuse to start when JWT_SECRET_KEY is missing (api.py
#               raises instead of generating an ephemeral key)
# development -> an ephemeral key is generated and logged as a warning
# Leave this unset locally; set it in any shared or deployed environment.
AIDA_ENV=development

# --- PostgreSQL ---
DATABASE_HOST=db
DATABASE_NAME=ai-delivery-assistant
DATABASE_USER=postgres
DATABASE_PASSWORD=

# --- AI Providers ---
# OpenRouter is the only provider the app actually calls by default.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Authentication (JWT) ---
# Signing key for bearer tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Bearer token lifetime in hours (default 12).
TOKEN_TTL_HOURS=12

# --- First-run bootstrap ---
# POST /api/auth/setup has no authenticated caller to check, so it is
# gated by this one-time token. Read it from the server logs when unset;
# set it explicitly so the first run is scriptable.
BOOTSTRAP_TOKEN=

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=
