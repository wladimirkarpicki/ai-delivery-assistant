# Copy to .env and fill in real values. NEVER commit the real .env file.
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"

# --- PostgreSQL ---
DATABASE_HOST=db
DATABASE_NAME=ai-delivery-assistant
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- AI Providers ---
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Authentication (JWT) ---
# Signing key for bearer tokens. change-me-in-production is a placeholder:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
# Bearer token lifetime in hours (default 12).
TOKEN_TTL_HOURS=12

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=admin
